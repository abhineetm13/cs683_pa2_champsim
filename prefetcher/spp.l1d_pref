#include "cache.h"

#define IP_TRACKER_COUNT 24
#define MASK_IP 0xFF
#define SIGNATURE_LENGTH 3
#define HISTORY_SIZE SIGNATURE_LENGTH
#define SIGNATURE_TABLE_SIZE 16
#define SIGNATURE_CONF_MAX 3
#define SIGNATURE_CONF_THRESHOLD 2
#define ACCURACY_EPOCH 256
#define UNIFORM_STRIDE_THRESHOLD 2
#define UNIFORM_CONF_MAX 7

// update degree based on recent prefetch accuracy
class Throttle {
  public:
    uint64_t issued_base;
    uint64_t useful_base;
    uint32_t degree;

    Throttle() {
        issued_base = 0;
        useful_base = 0;
        degree = 2;
    }

    void update_degree(CACHE* cache)
    {
        uint64_t issued_now = cache->pf_lower_level;
        uint64_t useful_now = cache->pf_useful;

        // ChampSim may reset statistics after warmup.
        if (issued_now < this->issued_base ||
            useful_now < this->useful_base) {
            this->issued_base = issued_now;
            this->useful_base = useful_now;
            return;
        }

        uint64_t issued_delta = issued_now - this->issued_base;

        if (issued_delta < ACCURACY_EPOCH) return;

        uint64_t useful_delta = useful_now - this->useful_base;

        uint32_t accuracy = static_cast<uint32_t>(std::min<uint64_t>(100, (100 * useful_delta) / issued_delta));

        if (accuracy >= 60)
            this->degree = 6;
        else if (accuracy >= 30)
            this->degree = 3;
        else
            this->degree = 1;

        this->issued_base = issued_now;
        this->useful_base = useful_now;
    }
};

class SIGNATURE_ENTRY {
  public:
    bool valid;
    uint16_t signature;
    int64_t next_stride;
    uint8_t confidence;

    SIGNATURE_ENTRY() {
        valid = false;
        signature = 0;
        next_stride = 0;
        confidence = 0;
    }
};

class IP_TRACKER {
  public:
    // the IP we're tracking
    uint64_t ip;

    bool valid;

    // the last address accessed by this IP
    uint64_t last_cl_addr;

    // Circular history of real (not predicted) strides. The head points
    // to the next insertion position.
    int64_t last_strides[HISTORY_SIZE];
    uint32_t last_strides_head;
    uint32_t history_count;

    int64_t uniform_stride;
    uint8_t uniform_confidence;

    // Maps a recent-stride signature to the next expected stride.
    SIGNATURE_ENTRY signature_table[SIGNATURE_TABLE_SIZE];

    // use LRU to evict old IP trackers
    uint32_t lru;

    IP_TRACKER () {
        valid = false;
        ip = 0;
        last_cl_addr = 0;
        for (int i = 0; i < HISTORY_SIZE; i++) last_strides[i] = 0;
        last_strides_head = 0;
        history_count = 0;
        uniform_stride = 0;
        uniform_confidence = 0;
        lru = 0;
    };
};

static bool make_signature(const int64_t history[], uint32_t head,
                           uint32_t count, uint16_t& signature)
{
    if (count < SIGNATURE_LENGTH)
        return false;

    uint32_t hash = 2166136261u;
    for (uint32_t i = 0; i < SIGNATURE_LENGTH; i++) {
        uint32_t history_index =
            (head + HISTORY_SIZE - SIGNATURE_LENGTH + i) % HISTORY_SIZE;
        uint64_t value = static_cast<uint64_t>(history[history_index]);

        hash ^= static_cast<uint32_t>(value);
        hash *= 16777619u;
        hash ^= static_cast<uint32_t>(value >> 32);
        hash *= 16777619u;
    }

    signature = static_cast<uint16_t>(hash ^ (hash >> 16));
    return true;
}

static void push_stride(int64_t history[], uint32_t& head,
                        uint32_t& count, int64_t stride)
{
    history[head] = stride;
    head = (head + 1) % HISTORY_SIZE;
    if (count < HISTORY_SIZE)
        count++;
}

static void train_signature(IP_TRACKER& tracker, uint16_t signature,
                            int64_t observed_stride)
{
    SIGNATURE_ENTRY& entry =
        tracker.signature_table[signature % SIGNATURE_TABLE_SIZE];

    if (!entry.valid || entry.signature != signature) {
        entry.valid = true;
        entry.signature = signature;
        entry.next_stride = observed_stride;
        entry.confidence = 1;
    }
    else if (entry.next_stride == observed_stride) {
        if (entry.confidence < SIGNATURE_CONF_MAX)
            entry.confidence++;
    }
    else if (entry.confidence > 1) {
        entry.confidence--;
    }
    else {
        entry.next_stride = observed_stride;
        entry.confidence = 1;
    }
}

static SIGNATURE_ENTRY* lookup_signature(IP_TRACKER& tracker,
                                         uint16_t signature)
{
    SIGNATURE_ENTRY& entry =
        tracker.signature_table[signature % SIGNATURE_TABLE_SIZE];

    if (!entry.valid || entry.signature != signature ||
        entry.confidence < SIGNATURE_CONF_THRESHOLD)
        return NULL;

    return &entry;
}

IP_TRACKER trackers[IP_TRACKER_COUNT];
Throttle throttle = Throttle();



void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    cout << "CPU " << cpu << " L1D IP-based stride prefetcher" << endl;

    for (int i=0; i<IP_TRACKER_COUNT; i++)
        trackers[i].lru = i;

}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
   	// check for a tracker hit
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    ip = ip & MASK_IP;

    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].valid && trackers[index].ip == ip)
            break;
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        uint32_t victim_lru = trackers[index].lru;
        trackers[index] = IP_TRACKER();
        trackers[index].ip = ip;
        trackers[index].valid = true;
        trackers[index].last_cl_addr = cl_addr;
        trackers[index].lru = victim_lru;

        //cout << "[IP_STRIDE] MISS index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << endl;
	for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return; //metadata_in;
    }

	// sanity check
    // at this point we should know a matching tracker index
    if (index == -1)
        assert(0);

    // calculate the stride between the current address and the last address
    // this bit appears overly complicated because we're calculating
    // differences between unsigned address variables
    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }

    //cout << "[IP_STRIDE] HIT  index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << " stride: " << stride << endl;

    // don't do anything if we somehow saw the same address twice in a row
    if (stride == 0)
        return;	//metadata_in;

    IP_TRACKER& tracker = trackers[index];

    // update the aggressiveness based on the accuracy
    throttle.update_degree(this);

    // signature of the old history maps to the newly observed stride
    uint16_t old_signature = 0;
    if (make_signature(tracker.last_strides, tracker.last_strides_head,
                       tracker.history_count, old_signature)) {
        train_signature(tracker, old_signature, stride);
    }

    // update uniform-stride predictor
    if (tracker.history_count > 0 && stride == tracker.uniform_stride) {
        if (tracker.uniform_confidence < UNIFORM_CONF_MAX)
            tracker.uniform_confidence++;
    }
    else {
        tracker.uniform_stride = stride;
        tracker.uniform_confidence = 1;
    }

    // update data-structures with new stride
    push_stride(tracker.last_strides, tracker.last_strides_head,
                tracker.history_count, stride);
    tracker.last_cl_addr = cl_addr;

    // Uniform prediction has priority over signature prediction.
    if (tracker.uniform_confidence > UNIFORM_STRIDE_THRESHOLD) {
        int64_t predicted_cl = static_cast<int64_t>(cl_addr);

        for (uint32_t i = 0; i < throttle.degree; i++) {
            if (tracker.uniform_stride > 0 &&
                predicted_cl > INT64_MAX - tracker.uniform_stride)
                break;
            if (tracker.uniform_stride < 0 &&
                predicted_cl < -tracker.uniform_stride)
                break;

            predicted_cl += tracker.uniform_stride;
            uint64_t pf_address =
                static_cast<uint64_t>(predicted_cl) << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) !=
                (addr >> LOG2_PAGE_SIZE))
                break;

            int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1))
                                 ? FILL_L1 : FILL_L2;
            if (!prefetch_line(ip, addr, pf_address, fill_level, 0))
                break;
        }
    }
    else {
        // Recursively predict using a temporary history. Predicted strides
        // must not train or otherwise modify the real history.
        int64_t temp_history[HISTORY_SIZE];
        for (uint32_t i = 0; i < HISTORY_SIZE; i++)
            temp_history[i] = tracker.last_strides[i];

        uint32_t temp_head = tracker.last_strides_head;
        uint32_t temp_count = tracker.history_count;
        int64_t predicted_cl = static_cast<int64_t>(cl_addr);

        for (uint32_t i = 0; i < throttle.degree; i++) {
            uint16_t signature = 0;
            if (!make_signature(temp_history, temp_head, temp_count,
                                signature))
                break;

            SIGNATURE_ENTRY* entry = lookup_signature(tracker, signature);
            if (entry == NULL || entry->next_stride == 0)
                break;

            int64_t predicted_stride = entry->next_stride;
            if (predicted_stride > 0 &&
                predicted_cl > INT64_MAX - predicted_stride)
                break;
            if (predicted_stride < 0 &&
                predicted_cl < -predicted_stride)
                break;

            predicted_cl += predicted_stride;
            uint64_t pf_address =
                static_cast<uint64_t>(predicted_cl) << LOG2_BLOCK_SIZE;

            if ((pf_address >> LOG2_PAGE_SIZE) !=
                (addr >> LOG2_PAGE_SIZE))
                break;

            int fill_level = (MSHR.occupancy < (MSHR.SIZE >> 1))
                                 ? FILL_L1 : FILL_L2;
            if (!prefetch_line(ip, addr, pf_address, fill_level, 0))
                break;

            push_stride(temp_history, temp_head, temp_count,
                        predicted_stride);
        }
    }

    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
    return; //metadata_in;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
	cout << "CPU " << cpu << " L1D PC-based stride pattern prefetcher final stats" << endl;
	cout << "Final degree: " << throttle.degree << endl;
}
