#include "cache.h"

#define IP_TRACKER_COUNT 24
#define PREFETCH_DEGREE 3
#define MASK_IP 0xFF
#define D 10
#define PREFETCH_CACHE_LEN
#define ACCURACY_EPOCH 256

// maintain possible cycle lengths, and a list of last D strides
// maybe try to detect cycle lengths of upto some distance D into the past
// maintain a set of possible cycle lengths
// on obtaining i-th fetch:
// first check if uniform is satisfied from the last D
// if yes, prefetch assuming uniform
// else:
// for each existing possible cycle length L, check if (i - L)th stride matches i-th stride 
//    if doesn't match, discard the length from the set
// for each stride length, we can maintain the number of times it matches till now, and give preference to that cycle length while prefetching.
// how to implement an accuracy checker? cache of last few prefetches for each ip?

// update degree based on recent prefetch accuracy
class Throttle {
  public:
    uint64_t issued_base;
    uint64_t useful_base;
    uint32_t degree;

    Throttle() {
        issued_base = 0;
        useful_base = 0;
        degree = 2;
    }

    void update_degree(CACHE* cache)
    {
        uint64_t issued_now = cache->pf_issued;
        uint64_t useful_now = cache->pf_useful;

        // ChampSim may reset statistics after warmup.
        if (issued_now < this->issued_base ||
            useful_now < this->useful_base) {
            this->issued_base = issued_now;
            this->useful_base = useful_now;
            return;
        }

        uint64_t issued_delta = issued_now - this->issued_base;

        if (issued_delta < ACCURACY_EPOCH) return;

        uint64_t useful_delta = useful_now - this->useful_base;

        uint32_t accuracy = static_cast<uint32_t>(std::min<uint64_t>(100, (100 * useful_delta) / issued_delta));

        if (accuracy >= 60)
            throttle.degree = 4;
        else if (accuracy >= 30)
            throttle.degree = 2;
        else
            throttle.degree = 1;

        throttle.issued_base = issued_now;
        throttle.useful_base = useful_now;
    }
};

class IP_TRACKER {
  public:
    // the IP we're tracking
    uint64_t ip;

    // the last address accessed by this IP
    uint64_t last_cl_addr;

    // the last D strides between addresses accessed by this IP
    int64_t last_strides[D+1]; // buffer which acts like a queue with max length D
    uint last_strides_head;
    
    // possible cycle lengths: non-zero if cycle length=i is possible, 0 if not possible
    int cycle_length_scores[D+1];

    // previous prefetches cache
    uint64_t prev_prefetches[PREFETCH_CACHE_LEN];

    // use LRU to evict old IP trackers
    uint32_t lru;

    IP_TRACKER () {
        ip = 0;
        last_cl_addr = 0;
        for (int i = 0; i < D; i++) last_strides[i] = 0;
        for (int i = 0; i < D; i++) cycle_lengths[i] = 0;
        for (int i = 0; i < PREFETCH_CACHE_LEN; i++) prev_prefetches[i] = 0;
        lru = 0;
    };
};

IP_TRACKER trackers[IP_TRACKER_COUNT];
Throttle throttle;



void CACHE::l1d_prefetcher_initialize() 
{
    std::cout << "------------------------------------------------" << std::endl;
    std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
    std::cout << "------------------------------------------------" << std::endl;
    cout << "CPU " << cpu << " L1D IP-based stride prefetcher" << endl;

    for (int i=0; i<IP_TRACKER_COUNT; i++)
        trackers[i].lru = i;

}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
   	// check for a tracker hit
    uint64_t cl_addr = addr >> LOG2_BLOCK_SIZE;

    ip = ip & MASK_IP;

    int index = -1;
    for (index=0; index<IP_TRACKER_COUNT; index++) {
        if (trackers[index].ip == ip)
            break;
    }

    // this is a new IP that doesn't have a tracker yet, so allocate one
    if (index == IP_TRACKER_COUNT) {

        for (index=0; index<IP_TRACKER_COUNT; index++) {
            if (trackers[index].lru == (IP_TRACKER_COUNT-1))
                break;
        }

        trackers[index].ip = ip;
        trackers[index].last_cl_addr = cl_addr;
        trackers[index].last_stride = 0;

        //cout << "[IP_STRIDE] MISS index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << endl;
	for (int i=0; i<IP_TRACKER_COUNT; i++) {
            if (trackers[i].lru < trackers[index].lru)
                trackers[i].lru++;
        }
        trackers[index].lru = 0;

        return; //metadata_in;
    }

	// sanity check
    // at this point we should know a matching tracker index
    if (index == -1)
        assert(0);

    // calculate the stride between the current address and the last address
    // this bit appears overly complicated because we're calculating
    // differences between unsigned address variables
    int64_t stride = 0;
    if (cl_addr > trackers[index].last_cl_addr)
        stride = cl_addr - trackers[index].last_cl_addr;
    else {
        stride = trackers[index].last_cl_addr - cl_addr;
        stride *= -1;
    }

    //cout << "[IP_STRIDE] HIT  index: " << index << " lru: " << trackers[index].lru << " ip: " << hex << ip << " cl_addr: " << cl_addr << dec << " stride: " << stride << endl;

    // need to update the aggressiveness based on the accuracy
    throttle.update_degree(this);

    // prefetching logic
    for (int i = 2; i <= D; i++) {
        if (last_strides[(last_strides_head-i)%(D+1)] == stride) {
            cycle_length_scores[i]++;
        }
        else {
            cycle_length_scores[i] = 0;
        }
    }

    // need to select the stride pattern cycle length

    // need to do the prefetching


    trackers[index].last_cl_addr = cl_addr;
    trackers[index].last_stride = stride;

    for (int i=0; i<IP_TRACKER_COUNT; i++) {
        if (trackers[i].lru < trackers[index].lru)
            trackers[i].lru++;
    }
    trackers[index].lru = 0;
    return; //metadata_in;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

void CACHE::l1d_prefetcher_final_stats()
{
	cout << "CPU " << cpu << " L1D PC-based stride pattern prefetcher final stats" << endl;
	cout << "Degree: " << PREFETCH_DEGREE << endl;
}
