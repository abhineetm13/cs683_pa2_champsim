#include "cache.h"

#define maxRRPV 3
uint32_t l2_rrpv[L2C_SET][L2C_WAY];

#define NUM_LEADER_SETS 32
#define EPOCH_LENGTH 1024
#define IRRIP_THRESHOLD 0.50

bool is_rrip_leader(uint32_t set)
{
    return (set % (L2C_SET / NUM_LEADER_SETS)) == 0;
}

bool global_use_irrip = false;

uint64_t epoch_accesses = 0;
uint64_t instr_misses = 0;
uint64_t data_misses = 0;

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize miss-pressure Dynamic I-RRIP state for L2C"
         << " (threshold=" << IRRIP_THRESHOLD << ")" << endl;

    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id,
                                uint32_t set, const BLOCK *current_set,
                                uint64_t ip, uint64_t full_addr, uint32_t type)
{
    bool use_irrip = !is_rrip_leader(set) && global_use_irrip;

    while (1) {
        if (use_irrip) {
            // When instruction misses dominate, evict data before instructions.
            for (int i = 0; i < L2C_WAY; i++) {
                if (l2_rrpv[set][i] == maxRRPV && !current_set[i].instruction)
                    return i;
            }
        }

        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV)
                return i;
        }

        for (int i = 0; i < L2C_WAY; i++) {
            l2_rrpv[set][i]++;
        }
    }
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set,
                                          uint32_t way, uint64_t full_addr,
                                          uint64_t ip, uint64_t victim_addr,
                                          uint32_t type, uint8_t hit,
                                          uint8_t isInstruction)
{
    bool use_irrip = !is_rrip_leader(set) && global_use_irrip;

    if (hit) {
        l2_rrpv[set][way] = 0;
    } else if (use_irrip && isInstruction) {
        l2_rrpv[set][way] = maxRRPV - 2;
    } else {
        l2_rrpv[set][way] = maxRRPV - 1;
    }

    // Sample demand-load miss pressure in the RRIP leader sets. Every sampled
    // instruction or data demand access advances the epoch.
    if (is_rrip_leader(set) && type == LOAD) {
        epoch_accesses++;

        if (!hit) {
            if (isInstruction)
                instr_misses++;
            else
                data_misses++;
        }

        if (epoch_accesses >= EPOCH_LENGTH) {
            uint64_t total_misses = instr_misses + data_misses;

            if (total_misses != 0) {
                double instruction_miss_pressure =
                    static_cast<double>(instr_misses) / total_misses;
                global_use_irrip =
                    instruction_miss_pressure > IRRIP_THRESHOLD;
            } else {
                global_use_irrip = false;
            }

            epoch_accesses = 0;
            instr_misses = 0;
            data_misses = 0;
        }
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
}
